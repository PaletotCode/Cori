    borderColor: "#E4E7EC",
    paddingHorizontal: 12,
    paddingVertical: 12,
    gap: 4,
  },
  kpiCardWide: {
    width: "100%",
  },
  kpiLabel: {
    color: "#667085",
    fontSize: 12,
    fontWeight: "600",
  },
  kpiValue: {
    color: "#101828",
    fontSize: 18,
    fontWeight: "700",
  },
  section: {
    borderRadius: 18,
    backgroundColor: "#FFFFFF",
