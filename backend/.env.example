APP_NAME=Cori V2 API
APP_ENV=development

DATABASE_URL=postgresql+psycopg://cori:cori@localhost:5432/cori
REDIS_URL=redis://localhost:6379/0
WORKER_HEARTBEAT_SECONDS=20
WORKER_ENABLE_SESSION_REMINDERS=false
JWT_SECRET_KEY=change-me-in-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP_MINUTES=30
REFRESH_TOKEN_EXP_DAYS=15
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_IOS_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_OAUTH_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
GOOGLE_OAUTH_HTTP_TIMEOUT_SECONDS=8
GOOGLE_OAUTH_ALLOWED_REDIRECT_URIS=
PATIENT_INVITE_BASE_URL=http://localhost:8081/paciente/convite
PATIENT_SESSIONS_BASE_URL=http://localhost:8081/paciente/sessoes
PATIENT_ACTIVITIES_BASE_URL=http://localhost:8081/paciente/atividades
PATIENT_FORMS_BASE_URL=http://localhost:8081/paciente/formularios
